	(text "U1: owned STM32G030F6P6TR. HSI/PLL; no crystal. I2C1 target 0x20 on PB6/PB7 AF6.\nROW0..3 = PA0..3; COL0..3 = PA4..7; RGB = PA8 TIM1_CH1 AF2; IRQ = PC15 open drain.\nLeave bonded PB8, PB3/4/5, PB0/1/2, PA10 and PA15 analog. SWD PA13/14; boot from flash.\nVBUS_SENSE = PA12 ADC_IN16: half VBUS. Default RGB low/off; enable only with USB."
		(exclude_from_sim no)
		(at 20.32 144.78 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "bfb7f3db-4f0a-42e5-9486-d896066e617a")
	)
	(text "FFC Type A, 1mm, 0.30mm end thickness; Molex 0151670213.\nButton pinout is reversed vs main: 1 USB5V / 2 IRQ / 3 SCL / 4 SDA / 5 3V3 / 6 GND.\nDo not add I2C pull-ups here. Main R9/R10=4.7k; 100kHz, 177.8mm cable.\nSeparate panel firmware + SWD fixture required; no panel USB bootloader."
		(exclude_from_sim no)
		(at 177.80 243.84 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "79b28902-a8d6-48d6-a814-d6867ee490b9")
	)
