	(text "1S BATTERY ACTUATORS: 1A/channel target; 1.3A operating bank budget including buzzer.\nU13 fast electronic current limit (~1.54A nominal); no one-time fuse. Protected battery pack required upstream."
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "d5e3ea98-5979-4f2e-807b-e5aaad203c75")
	)
	(text "Q5 opens the charger PROG return via Q6 while ACT_EN is high.\nCharging pauses during actuation; R53 defaults the bank OFF."
		(exclude_from_sim no)
		(at 233.68 17.78 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "ff087a76-4c4d-4f87-980b-4e99b902c5ad")
	)
	(text "ILM: 1k + 330R = 1.33k. dVdt: 100nF (~10ms at 4.2V).\nFLT is thermal fault, not an instant short interrupt; firmware must latch OFF.\nKeep C47 at IN and D23 at OUT. Battery input harness <=10cm target."
		(exclude_from_sim no)
		(at 149.86 81.28 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "6cc55168-8290-40fb-999c-b1d334c756e1")
	)
