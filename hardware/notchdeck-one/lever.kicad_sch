	(text "Onboard U5: 3.3V mode, DIR=GND.\nREMOVE R37 AND R38 for external power sensor on J10.\nOnly one AS5600 may be connected on each channel."
		(exclude_from_sim no)
		(at 231.14 83.82 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "ee17cf16-68c6-4e2b-a078-13fc2d6c0a6c")
	)
	(text "J10/J11: 1=3V3  2=GND  3=SDA  4=SCL. Internal harness <=20cm target, 100kHz; verify rise time.\n3.3V sensors only; no extra harness pull-ups. No hot-plug. External sensors require local decoupling."
		(exclude_from_sim no)
		(at 20.32 139.70 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "51e0c9e9-b944-40be-a30f-19ec612661a8")
	)
	(text "REV D GRAY HARNESS: J5 brake/mascon: 1=GND, 2..5=S0..S3, 6=3V3. J12 power: 1=GND, 2..4=S0..S2, 5=3V3.\nDry contacts connect bits to GND; leave 3V3 unpopulated in passive harness. Open=1, closed=0; all-open is invalid.\n10k / 1k / 100nF + software debounce. Use microload contacts qualified for 3.3V / 0.33mA. Not compatible with Rev C cables."
		(exclude_from_sim no)
		(at 20.32 210.82 0)
