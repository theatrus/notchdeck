	(text "Onboard U5: 3.3V mode, DIR=GND.\nREMOVE R37 AND R38 for external power sensor on J10.\nOnly one AS5600 may be connected on each channel."
		(exclude_from_sim no)
		(at 231.14 83.82 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "9d3909ad-3061-4db0-9af5-490bba818e86")
	)
	(text "J10/J11: 1=3V3  2=GND  3=SDA  4=SCL. Internal harness <=20cm target, 100kHz; verify rise time.\n3.3V sensors only; no extra harness pull-ups. No hot-plug. External sensors require local decoupling."
		(exclude_from_sim no)
		(at 20.32 139.70 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "6783a059-62a3-4f07-8ad5-91ee7cab362b")
	)
	(text "GRAY CONTACTS: J5-J8 = brake / combined (4 bits); J12-J14 = power (3 bits).\nPin 1=signal, 2=GND. Open=1, closed=0; reserve all-open as invalid. 10k/1k/100nF + software debounce.\nUse microload contacts qualified for 3.3V / 0.33mA, or revise pull-ups to suit the chosen switch."
		(exclude_from_sim no)
		(at 20.32 210.82 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "805b015e-b8a5-4c3c-a02f-41d0619eaa8b")
