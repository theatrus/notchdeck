	(text "SWD headers are parallel; VTref is 3V3. SWO is unused.\nReset: P0.18 / UICR reset enabled; also resets handle mux.\nNFC pins P0.09/P0.10 must be configured as GPIO.\nP0.00/P0.01 are buttons: use calibrated RC LFCLK, no LFXO.\nP0.29/P0.31/P0.30 = power Gray bits S0/S1/S2. No spare GPIO."
		(exclude_from_sim no)
		(at 25.40 223.52 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
