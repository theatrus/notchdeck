	(text "Q1: D = BAT+, S = VSYS.\nR5 1k from VBUS; R4 100k to GND.\nBody diode blocks VSYS charging BAT+."
		(exclude_from_sim no)
		(at 187.96 132.08 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "0d303c40-3e71-43f5-90c8-8fb4fd06a69d")
	)
	(text "U3 is MCP73832 (open-drain STAT), not MCP73831.\nR3 = 2k: 500mA charge. Match cell and USB source budget.\nJ2: protected 1S Li-ion pack, pin 1 positive, pin 2 GND."
		(exclude_from_sim no)
		(at 25.40 226.06 0)
		(effects (font (face "Courier New") (size 1.27 1.27)) (justify left top))
		(uuid "b2f1ae2c-11cf-4835-9a2c-7f916a480e53")
	)
	(text "MAX17048: I2C1 / address 0x36.\nCELL + VDD -> BAT+; CTG/QSTRT/EP -> GND.\nAS5600 has its own bus to avoid address collision."
