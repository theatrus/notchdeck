/* Rev C/D E73 module mapping. Apply as DTC_OVERLAY_FILE, replacing the DK overlay.
 * Board platform remains DK for SDK bring-up; bootloader/USB IDs still provisional. */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

&pinctrl {
    notchdeck_i2c0_default: notchdeck_i2c0_default {
        group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 26)>, <NRF_PSEL(TWIM_SCL, 0, 6)>; };
    };
    notchdeck_i2c0_sleep: notchdeck_i2c0_sleep {
        group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 26)>, <NRF_PSEL(TWIM_SCL, 0, 6)>; low-power-enable; };
    };
    notchdeck_i2c1_default: notchdeck_i2c1_default {
        group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 12)>, <NRF_PSEL(TWIM_SCL, 0, 7)>; };
    };
    notchdeck_i2c1_sleep: notchdeck_i2c1_sleep {
        group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 12)>, <NRF_PSEL(TWIM_SCL, 0, 7)>; low-power-enable; };
    };
};
&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&notchdeck_i2c0_default>;
    pinctrl-1 = <&notchdeck_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
};
&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&notchdeck_i2c1_default>;
    pinctrl-1 = <&notchdeck_i2c1_sleep>;
    pinctrl-names = "default", "sleep";
};
/* TWIM1 and SPIM1 share hardware: reserve instance 1 for the fuel gauge.
 * Future RGB SPI pinctrl must use instance 2/3. Disable DK UART pin conflicts. */
&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&uart0 { status = "disabled"; };
&uart1 { status = "disabled"; };
&spi3 { status = "disabled"; };
&pwm0 { status = "disabled"; };
&qspi { status = "disabled"; };
&nfct { status = "disabled"; };
&uicr { gpio-as-nreset; nfct-pins-as-gpios; };
&gpio0 {
    gpio-reserved-ranges = <18 1>;
    /delete-property/ gpio-line-names;
};
&gpio1 { /delete-property/ gpio-line-names; };
/ {
    /delete-node/ buttons;
    /delete-node/ leds;
    /delete-node/ pwmleds;
    aliases {
        /delete-property/ led0;
        /delete-property/ led1;
        /delete-property/ led2;
        /delete-property/ led3;
        /delete-property/ pwm-led0;
        /delete-property/ sw0;
        /delete-property/ sw1;
        /delete-property/ sw2;
        /delete-property/ sw3;
        /delete-property/ mcuboot-button0;
        /delete-property/ mcuboot-led0;
    };
    buttons: buttons {
        compatible = "gpio-keys";
        btn1 { gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn2 { gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn3 { gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn4 { gpios = <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn5 { gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn6 { gpios = <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn7 { gpios = <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn8 { gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn9 { gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn10 { gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn11 { gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
        btn12 { gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
    };
    handle_inputs {
        compatible = "gpio-keys";
        brake_s0: brake_s0 { gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>; };
        brake_s1: brake_s1 { gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>; };
        brake_s2: brake_s2 { gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>; };
        brake_s3: brake_s3 { gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; };
        power_s0: power_s0 { gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>; };
        power_s1: power_s1 { gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>; };
        power_s2: power_s2 { gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>; };
    };
};
